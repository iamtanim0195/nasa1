# ---------------------------------------------------------------------------
# EARTH-METAMORPHOSIS — environment template
# Copy to `.env.local`, or set these as project env vars when deploying.
# Nothing here is secret: every value is inlined into the client bundle at
# build time.
# ---------------------------------------------------------------------------

# Base URL of the backend. Leave empty ONLY if you intend to run on fixtures.
# For a deployed frontend this must be the public backend origin, e.g.
#   NEXT_PUBLIC_API_BASE_URL=https://<your-backend>.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT=20000

# Use the in-repo mock transport instead of real HTTP calls.
#
# DANGER: the check is `USE_MOCK_API = env !== 'false'`, so ANY value other than
# the exact lowercase string "false" - including unset, empty, "0", "FALSE" or
# "true" - selects the mocks. A deploy that forgets this variable renders
# deterministic fixtures while the header still reports "Feed live", so the
# failure is invisible. The backend is implemented, so default to live:
NEXT_PUBLIC_USE_MOCK_API=false

# --- Cesium -----------------------------------------------------------------
# By default the Cesium runtime is loaded from a CDN. To self-host, copy
# node_modules/cesium/Build/Cesium into public/cesium and set this to /cesium
# (prefix with NEXT_PUBLIC_BASE_PATH for sub-path deployments).
# NOTE: `cesium` is deliberately NOT an npm dependency — it is fetched from this
# CDN at runtime, so code must use the loaded namespace, not `import 'cesium'`.
NEXT_PUBLIC_CESIUM_BASE_URL=https://cdn.jsdelivr.net/npm/cesium@1.126.0/Build/Cesium

# Ion token — required only for Cesium World Terrain / Bing imagery.
# Without it the globe falls back to open, token-free imagery providers.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Deployment -------------------------------------------------------------
# Set to /<repo-name> for GitHub Pages style sub-path hosting.
NEXT_PUBLIC_BASE_PATH=
