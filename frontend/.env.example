# ---------------------------------------------------------------------------
# EARTH-METAMORPHOSIS — environment template
# Copy to `.env.local` and fill in. Nothing here is a secret in the frontend
# sense: every value is inlined into the client bundle at build time.
# ---------------------------------------------------------------------------

# Base URL of the backend that will implement the API contract in
# docs/API-CONTRACT.md. Leave empty to run the built-in mock transport.
NEXT_PUBLIC_API_BASE_URL=

# Request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT=20000

# Use the in-repo mock transport instead of real HTTP calls.
#   true  -> no network calls, deterministic fixtures (great for demos/CI)
#   false -> real axios calls against NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_USE_MOCK_API=true

# --- Cesium -----------------------------------------------------------------
# By default the Cesium runtime is loaded from a CDN. To self-host, copy
# node_modules/cesium/Build/Cesium into public/cesium and set this to /cesium
# (prefix with NEXT_PUBLIC_BASE_PATH for sub-path deployments).
NEXT_PUBLIC_CESIUM_BASE_URL=https://cdn.jsdelivr.net/npm/cesium@1.126.0/Build/Cesium

# Ion token — required only for Cesium World Terrain / Bing imagery.
# Without it the globe falls back to open, token-free imagery providers.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Deployment -------------------------------------------------------------
# Set to /<repo-name> for GitHub Pages style sub-path hosting.
NEXT_PUBLIC_BASE_PATH=
