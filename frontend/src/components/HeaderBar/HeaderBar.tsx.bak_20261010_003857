'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { Eye, EyeOff, Play, Pause } from 'lucide-react';
import { cn, formatCompact, formatPercent } from '@/lib/utils';
import { useAppStore } from '@/store/appStore';
import { useMissionSummary } from '@/hooks/useMissionSummary';
import { useTheme } from '@/hooks/useTheme';
import { AnalysisDropdown } from '@/components/AnalysisDropdown';
import { Badge } from '@/components/ui/Badge';
import { Button } from '@/components/ui/Button';

export interface HeaderBarProps {
  onToggleSidebar?: () => void;
  sidebarOpen?: boolean;
  className?: string;
}

const NAV = [
  { href: '/', label: 'Dashboard', icon: Globe2 },
  { href: '/analyze', label: 'Analyze', icon: Activity },
  { href: '/results', label: 'Results', icon: Gauge },
];

/**
 * Mission status bar.
 *
 * Persistent across all routes so the operator never loses sight of whether the
 * feed is live, how much area is under monitoring, and how far the current job
 * has progressed.
 */
export function HeaderBar({ onToggleSidebar, sidebarOpen, className }: HeaderBarProps) {
  const pathname = usePathname();
  const autoRotate = useAppStore((state) => state.autoRotate);
  const showEvents = useAppStore((state) => state.showEvents);
  const setShowEvents = useAppStore((state) => state.setShowEvents);
  const toggleAutoRotate = useAppStore((state) => state.toggleAutoRotate);
  const { summary, isLoading, isError } = useMissionSummary();
  const { isDark, toggleTheme } = useTheme();

  const status: 'online' | 'degraded' | 'offline' = isError
    ? 'offline'
    : isLoading
      ? 'degraded'
      : 'online';

  return (
    <header
      className={cn(
        'relative z-chrome flex h-14 shrink-0 items-center gap-3 border-b border-hairline/8 bg-space-950/78 px-3 backdrop-blur-xl',
        className,
      )}
    >
      {/* Mobile rail toggle */}
      <Button
        size="icon"
        variant="ghost"
        aria-label={sidebarOpen ? 'Hide controls' : 'Show controls'}
        aria-expanded={sidebarOpen}
        onClick={onToggleSidebar}
        className="lg:hidden"
        icon={<Menu className="h-4 w-4" />}
      />

      {/* Identity */}
      <div className="flex min-w-0 items-center gap-2.5">
        <span className="relative hidden h-8 w-8 shrink-0 place-items-center rounded-lg border border-accent/30 bg-accent/10 text-accent sm:grid">
          <Satellite className="h-4 w-4" />
          <span className="absolute -right-0.5 -top-0.5 h-2 w-2 animate-pulse rounded-full bg-signal-low" />
        </span>
        <div className="min-w-0">
          <p className="truncate text-[11.5px] font-bold uppercase tracking-[0.13em] text-gradient">
            Earth-Metamorphosis
          </p>
          <p className="hidden truncate text-[9.5px] text-ink-faint sm:block">
            NISAR Change Detection Platform
          </p>
        </div>
      </div>

      {/* Telemetry strip */}
      <div className="ml-2 hidden items-center gap-2 xl:flex">
        <Metric
          icon={<Radio className="h-3 w-3" />}
          label="Active events"
          value={summary ? formatCompact(summary.activeEvents) : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          loading={isLoading}
        />
        <Metric
          icon={<Globe2 className="h-3 w-3" />}
          label="Monitored"
          value={summary ? `${formatCompact(summary.monitoredAreaKm2)} kmÃƒâ€šÃ‚Â²` : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          loading={isLoading}
        />
        <Metric
          icon={<Activity className="h-3 w-3" />}
          label="Scenes"
          value={summary ? formatCompact(summary.scenesIngested) : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          loading={isLoading}
        />
        <Metric
          icon={<Gauge className="h-3 w-3" />}
          label="Uptime"
          value={summary ? formatPercent(summary.uptimeRatio, 2) : 'ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â'}
          loading={isLoading}
        />
      </div>

      {/* Right cluster */}
      <div className="ml-auto flex items-center gap-2">
        {/* Route nav */}
        <nav className="flex items-center gap-1" aria-label="Sections">
          {NAV.map((item) => {
            const Icon = item.icon;
            const active = pathname === item.href;
            return (
              <Link
                key={item.href}
                href={item.href}
                aria-current={active ? 'page' : undefined}
                className={cn(
                  'flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-[11px] font-medium transition-colors',
                  active
                    ? 'bg-accent/12 text-accent'
                    : 'text-ink-muted hover:bg-elevate/6 hover:text-ink',
                )}
              >
                <Icon className="h-3.5 w-3.5" />
                <span className="hidden lg:inline">{item.label}</span>
              </Link>
            );
          })}
        </nav>

        <Badge
          tone={status === 'online' ? 'success' : status === 'degraded' ? 'warning' : 'danger'}
          dot
        >
          {status === 'online' ? 'Feed live' : status === 'degraded' ? 'Syncing' : 'Offline'}
        </Badge>

        {/* Auto-rotation. On by default; hovering the globe suspends the spin
            without touching this flag ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â see src/lib/cesium/rotation.ts. */}
        
        {/* Event Markers Toggle — Auto-added */}

        <Button

          size="icon"

          variant="ghost"

          aria-label={showEvents ? 'Hide event markers' : 'Show event markers'}

          aria-pressed={showEvents}

          title={showEvents ? 'Hide events' : 'Show events'}

          onClick={() => setShowEvents(!showEvents)}

          icon={showEvents ? <Eye className="h-4 w-4" /> : <EyeOff className="h-4 w-4" />}

          className={showEvents ? 'text-accent' : 'text-ink-muted'}

        />

        <Button
          size="icon"
          variant={autoRotate ? 'outline' : 'ghost'}
          onClick={toggleAutoRotate}
          aria-pressed={autoRotate}
          aria-label={autoRotate ? 'Stop globe auto-rotation' : 'Start globe auto-rotation'}
          title={
            autoRotate ? 'Auto-rotation: on ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â dragging or zooming stops it' : 'Auto-rotation: off'
          }
          icon={
            autoRotate ? (
              <Pause className="h-3.5 w-3.5 text-accent" />
            ) : (
              <Play className="h-3.5 w-3.5" />
            )
          }
        />

        {/* Theme. The icon shows the theme you would switch *to*, not the one you
            are in ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â the usual convention, and it removes the guesswork. */}
        <Button
          size="icon"
          variant={isDark ? 'ghost' : 'outline'}
          onClick={toggleTheme}
          aria-pressed={!isDark}
          aria-label={isDark ? 'Switch to light theme' : 'Switch to dark theme'}
          title={isDark ? 'Light theme' : 'Dark theme'}
          icon={isDark ? <Sun className="h-3.5 w-3.5" /> : <Moon className="h-3.5 w-3.5" />}
        />

        {/* ANALYSIS MENU */}
        <AnalysisDropdown />
      </div>
    </header>
  );
}

/* -------------------------------------------------------------------------- */
/* Metric chip                                                                */
/* -------------------------------------------------------------------------- */

function Metric({
  icon,
  label,
  value,
  loading,
}: {
  icon: React.ReactNode;
  label: string;
  value: string;
  loading?: boolean;
}) {
  return (
    <div className="flex items-center gap-2 rounded-lg border border-hairline/8 bg-elevate/4 px-2.5 py-1.5">
      <span className="text-ink-faint">{icon}</span>
      <div className="leading-none">
        <p className="text-[8.5px] uppercase tracking-wider text-ink-faint">{label}</p>
        <p
          className={cn(
            'telemetry mt-0.5 text-[11px] font-semibold text-ink',
            loading && 'animate-pulse text-ink-faint',
          )}
        >
          {value}
        </p>
      </div>
    </div>
  );
}
