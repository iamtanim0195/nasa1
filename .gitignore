# ===== Self-hosted Cesium (frontend) =====
public/cesium
.tools/.tmp

# The generic `.python-version` above is meant for local virtualenv markers, but
# the backend's deploy pin is a real artefact: Nixpacks reads it to choose the
# interpreter, so it must be committed.
!backend/.python-version

# ===== Jupyter =====
.ipynb_checkpoints/


# ================= Output Files (Generated) =================
# Raw pipeline output stays out of git: the intermediate GeoTIFFs and NPY
# arrays are tens of megabytes each, and the HDF5 granules behind them are
# 3.5 GB and cannot be deployed at all.
*.npy
*.tif
*.tiff
*.h5
*.hdf5

# EXCEPTION: the small per-module result artifacts ARE committed, so a deployed
# backend - which has no granules and therefore cannot re-run the pipeline - can
# still serve real results and preview images. Curated set is ~13 MB:
#   <module>_metadata.json   what /api/results reads
#   <module>_preview.png     the overlay image
#   <module>_mask.tif        the downloadable GeoTIFF
#
# These rules must come AFTER the broad globs above, because the LAST matching
# pattern decides. A bare `output/` would also be wrong: git would not descend
# into the directory, so no negation inside it could ever re-include a file.
/output/*
!/output/*/
/output/*/*
!/output/*/*_metadata.json
!/output/*/*_preview.png
!/output/*/*_detection.png
!/output/*/*_mask.tif

# Re-exclude directories that only happen to match the negations above:
#   _baseline_feni_backup/  a local reproducibility baseline, not a deliverable
#   preview/                stale PNGs from an earlier pipeline run
/output/_baseline_feni_backup/
/output/preview/

# ================= NISAR Data =================
nisar_data/

# ================= Extra Files =================
nasa1/
nasa1.zip
*.zip

# ================= Auth =================
.netrc
_netrc

# ================= Stray nested copy =================
# A second full checkout of the frontend (with its own node_modules) that
# `tsconfig.json` was type-checking, which broke `next build`. Now excluded from
# the build; also kept out of git so it cannot bloat the repo (~600 MB).
frontend/earth-metamorphosis/

# ================= Editor / manual backups =================
# Snapshot copies left in the tree (e.g. Workspace.tsx.backup_20261007_210000).
# These sit inside tsconfig's include and previously produced build errors.
*.backup_*
*.bak
# Backup files
*.bak_*
*.bak


# ---- Earth Metamorphosis runtime artifacts ----
# Pipeline outputs (masks, previews, metadata) are regenerated per analysis.
output/
nisar_data/

# Backup files (created by edit scripts)
*.bak
*.bak_*
*.backup_*

# Python
__pycache__/
*.pyc
backend/venv/
venv/

# Next.js
frontend/.next/
frontend/out/
frontend/node_modules/

# OS
.DS_Store
Thumbs.db
