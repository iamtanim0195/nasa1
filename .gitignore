# ============================================
# Root .gitignore (covers both backend/ & frontend/)
# ============================================

# ===== Python (Backend) =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Build artefacts live at the REPO ROOT. Anchoring with a leading slash matters:
# an unanchored `lib/` also matches frontend/src/lib, which silently excluded the
# entire Cesium globe + utils + constants from git (16 source files, never
# committed). Same hazard for the other setuptools output dirs below.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

