# ============================================
# Root .gitignore (covers both backend/ & frontend/)
# ============================================

# ===== Python (Backend) =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Build artefacts live at the REPO ROOT. Anchoring with a leading slash matters:
# an unanchored `lib/` also matches frontend/src/lib, which silently excluded the
# entire Cesium globe + utils + constants from git (16 source files, never
# committed). Same hazard for the other setuptools output dirs below.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Testing (Python)
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Data files (বড় ফাইল)
*.h5
*.hdf5
*.he5
*.tif
*.tiff
*.nc
data/
outputs/
*.geojson
*.geotiff
*.png
*.jpg
!docs/**/*.png
!docs/**/*.jpg

# ===== Node (Frontend) =====
node_modules/
.next/
out/
build/
.vercel
*.tsbuildinfo
next-env.d.ts
coverage/

# ===== Environment files =====
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ===== OS / Editor =====
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ===== Self-hosted Cesium (frontend) =====
public/cesium
.tools/.tmp

# ===== Jupyter =====
.ipynb_checkpoints/


# ================= Output Files (Generated) =================
output/
*.npy
*.tif
*.tiff
*.h5
*.hdf5

# ================= NISAR Data =================
nisar_data/

# ================= Extra Files =================
nasa1/
nasa1.zip
*.zip

# ================= Auth =================
.netrc
_netrc

# ================= Stray nested copy =================
# A second full checkout of the frontend (with its own node_modules) that
# `tsconfig.json` was type-checking, which broke `next build`. Now excluded from
# the build; also kept out of git so it cannot bloat the repo (~600 MB).
frontend/earth-metamorphosis/

# ================= Editor / manual backups =================
# Snapshot copies left in the tree (e.g. Workspace.tsx.backup_20261007_210000).
# These sit inside tsconfig's include and previously produced build errors.
*.backup_*
*.bak